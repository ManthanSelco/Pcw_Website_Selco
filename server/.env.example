# Copy to server/.env

PORT=4000

# Public website address (used for Google, sitemap.xml, share previews). Set it on the server, e.g.
# SITE_URL=https://pcw.16-192-105-187.sslip.io
SITE_URL=

# MongoDB connection string.
# Local MongoDB:            mongodb://127.0.0.1:27017/pcw
# MongoDB Atlas (cloud):    mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/pcw
# Leave EMPTY to save data in a local file (data/db.json) - only for quick testing.
MONGODB_URI=

# Admin panel login (http://localhost:4000/admin).
# Change these two lines and restart the server (npm start) to change the login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Pcw@2026

# Optional: long random text used to sign admin logins. If empty, one is generated
# and saved in data/.jwt-secret automatically.
JWT_SECRET=

# Add sample events the first time the database is empty (true/false)
SEED_SAMPLES=true

# ---------- Images in AWS S3 ----------
# Leave S3_BUCKET empty to keep uploaded images on this computer (data/uploads).
# With S3 the bucket can stay PRIVATE: the website streams images through this server.
S3_BUCKET=
S3_REGION=ap-south-1
# Folder inside the bucket
S3_PREFIX=project/images/pcw
# AWS keys: NOT needed on EC2 if the server has an IAM role with S3 access (recommended).
# On a laptop, put an IAM user's keys here (needs s3:PutObject, s3:GetObject, s3:DeleteObject on the bucket).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: public/CloudFront address of the bucket, e.g. https://dxxxx.cloudfront.net
# If set, images are linked there directly instead of going through this server.
S3_PUBLIC_URL=
